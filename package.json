{
  "name": "pi-tailscale-serve",
  "version": "0.1.0",
  "description": "Pi coding agent extension for serving temporary dashboards via Tailscale",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "pi --extension src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "tailscale",
    "dashboard",
    "serving"
  ],
  "author": "Adam Thompson <adam@thesonofthomp.com>",
  "license": "MIT",
  "homepage": "https://github.com/TheSonOfThomp/pi-tailscale-serve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheSonOfThomp/pi-tailscale-serve.git"
  },
  "bugs": {
    "url": "https://github.com/TheSonOfThomp/pi-tailscale-serve/issues"
  },
  "pi": {
    "extensions": ["src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "dependencies": {
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "dependencies": {
    "uuid": "^11.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}

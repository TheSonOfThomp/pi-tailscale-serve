{
  "name": "pi-tailscale-serve",
  "version": "0.1.0",
  "description": "Pi coding agent extension for serving temporary dashboards via Tailscale",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "pi --extension src/index.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "tailscale",
    "dashboard",
    "serving"
  ],
  "author": "Adam",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@earendil-works/pi-coding-agent": "^2026.7.1",
    "@earendil-works/pi-tui": "^2026.7.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "name": "pi-tailscale-serve",
  "version": "0.1.0",
  "description": "Pi coding agent extension for serving temporary dashboards via Tailscale",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "pi --extension src/index.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "tailscale",
    "dashboard",
    "serving"
  ],
  "author": "Adam",
  "license": "MIT",
  "pi": {
    "extensions": ["src/index.ts"]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "dependencies": {
    "uuid": "^11.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
